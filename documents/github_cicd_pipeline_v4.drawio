<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="nama-cicd-v4-fbp" name="GitHub CI/CD - Feature Branch Promotion v4">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="GitHub CI/CD Pipeline — Nama TIPMS  |  v4.0  |  Feature Branch Promotion  |  Gated Sequential Deployment" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=15;fillColor=#0D7377;strokeColor=#00574B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2980" height="60" as="geometry"/></mxCell>
        <mxCell id="dev_c" value="👨‍💻  DEVELOPERS" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="80" width="350" height="310" as="geometry"/></mxCell>
        <mxCell id="dev_box" value="&lt;b&gt;💻 Developer Laptop&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uses Conventional Commits:&lt;br&gt;&lt;i&gt;feat(permits): add renewal UI&lt;/i&gt;&lt;br&gt;&lt;i&gt;fix(lab): correct SLA calc&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Create feature/INS-123 branch&lt;br&gt;2. Write code + commit&lt;br&gt;3. Push → CI triggers automatically&lt;br&gt;4. Branch deleted after merge to main" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="330" height="260" as="geometry"/></mxCell>
        <mxCell id="gh_c" value="☁️  GITHUB.COM" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="370" y="80" width="2620" height="310" as="geometry"/></mxCell>
        <mxCell id="repo" value="&lt;b&gt;📁 Repository (nama-tipms)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Feature Branch Promotion ✅&lt;/b&gt;&lt;br&gt;&lt;br&gt;feature/INS-123 → Dev → UAT → main → Production&lt;br&gt;&lt;br&gt;✅ Same commit SHA across all envs&lt;br&gt;✅ 2 approvals required to merge to main&lt;br&gt;✅ CI must pass before any deployment&lt;br&gt;✅ Branch deleted after merge&lt;br&gt;❌ No direct push to main" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="380" y="115" width="490" height="265" as="geometry"/></mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;📦 GHCR — 2 Separate Images ✅&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔵 &lt;b&gt;nama-permit-api:{sha}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;FROM node:20.11-alpine3.19&lt;br&gt;&amp;nbsp;&amp;nbsp;Built once from feature branch&lt;br&gt;&lt;br&gt;🟢 &lt;b&gt;nama-permit-web:{sha}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;FROM nginx:1.27-alpine&lt;br&gt;&amp;nbsp;&amp;nbsp;Same image promoted Dev→UAT→Prod&lt;br&gt;&lt;br&gt;Re-tagged v1.3.0 after merge to main" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="880" y="115" width="490" height="265" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;🔐 GitHub Secrets&lt;/b&gt;&lt;br&gt;&lt;br&gt;• DB_PASSWORD&lt;br&gt;• JWT_SECRET_KEY&lt;br&gt;• FCM_SERVER_KEY&lt;br&gt;• APNS_AUTH_KEY&lt;br&gt;• ANDROID_KEYSTORE (file)&lt;br&gt;• CODEMAGIC_API_TOKEN&lt;br&gt;• SRV_DEV_SSH_KEY&lt;br&gt;• SRV_UAT_SSH_KEY&lt;br&gt;• SRV_PROD_SSH_KEY" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1380" y="115" width="360" height="265" as="geometry"/></mxCell>
        <mxCell id="gh_envs" value="&lt;b&gt;🌍 GitHub Environments — 3 Gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;🌿 &lt;b&gt;dev&lt;/b&gt; — Auto after CI passes&lt;br&gt;&amp;nbsp;&amp;nbsp;No approval · concurrency group&lt;br&gt;&lt;br&gt;📋 &lt;b&gt;uat&lt;/b&gt; — Gate 1 required&lt;br&gt;&amp;nbsp;&amp;nbsp;Dev Lead / QA must approve&lt;br&gt;&amp;nbsp;&amp;nbsp;workflow_dispatch only · SHA verified&lt;br&gt;&lt;br&gt;🔒 &lt;b&gt;production&lt;/b&gt; — Gate 2 + Gate 3&lt;br&gt;&amp;nbsp;&amp;nbsp;UAT Lead + BA sign-off (Gate 2)&lt;br&gt;&amp;nbsp;&amp;nbsp;PR merged to main (Gate 3: 2 reviewers)&lt;br&gt;&amp;nbsp;&amp;nbsp;Window: Sunday 03:00–06:00 OST&lt;br&gt;&lt;br&gt;&lt;b&gt;❌ NO BYPASS — Dev → UAT → Prod mandatory&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1750" y="115" width="1230" height="265" as="geometry"/></mxCell>
        <mxCell id="pipe_c" value="⚙️  GITHUB ACTIONS — CI/CD PIPELINE  (.github/workflows/)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="2980" height="1090" as="geometry"/></mxCell>
        <mxCell id="no_bypass" value="🚫  NO BYPASS RULE — Every commit must travel: Dev  →  UAT  →  Production  |  Skipping any environment is blocked by GitHub Environment protection rules" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#4A0000;strokeColor=#D32F2F;fontColor=#FFCDD2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="443" width="2950" height="35" as="geometry"/></mxCell>
        <mxCell id="trigger_bar" value="⚡ Triggered by: Push to feature/* branch  |  CI runs on every commit to the feature branch" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="20" y="486" width="1480" height="35" as="geometry"/></mxCell>
        <mxCell id="cache_bar" value="🚀 actions/cache: node_modules · ~/.gradle · pub-cache" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="486" width="1450" height="35" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;✅ STAGE 1 — VALIDATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ESLint + Prettier + Stylelint&lt;br&gt;• Gitleaks (secret scan)&lt;br&gt;• npm audit (dep CVEs)&lt;br&gt;&lt;br&gt;Fails on any error&lt;br&gt;⏱ ~60 seconds" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="20" y="531" width="310" height="200" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;✅ STAGE 2 — TEST&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Vitest (Vue 3) + Jest (Node.js)&lt;br&gt;• Coverage ≥ 70% enforced&lt;br&gt;&lt;br&gt;&lt;b&gt;Integration Tests&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;services: postgres:16&lt;br&gt;&amp;nbsp;&amp;nbsp;Real DB, real schema&lt;br&gt;⏱ ~3 minutes" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="340" y="531" width="330" height="200" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;✅ STAGE 3 — SAST&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Semgrep / CodeQL&lt;br&gt;• OWASP Top 10 patterns&lt;br&gt;• SQL injection, XSS&lt;br&gt;&lt;br&gt;FAIL: HIGH / CRITICAL&lt;br&gt;⏱ ~2 minutes" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="680" y="531" width="270" height="200" as="geometry"/></mxCell>
        <mxCell id="s4h" value="&lt;b&gt;STAGE 4 — BUILD&lt;/b&gt;  (2 parallel jobs)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="960" y="531" width="370" height="28" as="geometry"/></mxCell>
        <mxCell id="s4a" value="&lt;b&gt;🔵 BACKEND IMAGE&lt;/b&gt;&lt;br&gt;FROM node:20.11-alpine3.19&lt;br&gt;npm ci · non-root user&lt;br&gt;→ permit-api:&lt;b&gt;{commit-sha}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="960" y="563" width="370" height="80" as="geometry"/></mxCell>
        <mxCell id="s4b" value="&lt;b&gt;🟢 FRONTEND IMAGE&lt;/b&gt;&lt;br&gt;npm run build → dist/&lt;br&gt;FROM nginx:1.27-alpine&lt;br&gt;→ permit-web:&lt;b&gt;{commit-sha}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="960" y="647" width="370" height="80" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;✅ STAGE 5 — TRIVY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scans both images&lt;br&gt;OS CVEs in layers&lt;br&gt;&lt;br&gt;FAIL: CRITICAL CVEs&lt;br&gt;WARN: HIGH CVEs&lt;br&gt;⏱ ~2 minutes" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1340" y="531" width="270" height="200" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;📤 PUSH TO GHCR&lt;/b&gt;&lt;br&gt;&lt;br&gt;docker login ghcr.io&lt;br&gt;&amp;nbsp;&amp;nbsp;uses GITHUB_TOKEN ✅&lt;br&gt;Pushes: API + WEB images&lt;br&gt;Tagged: {commit-sha}&lt;br&gt;&lt;br&gt;&lt;i&gt;concurrency group active&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="1620" y="531" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="sha_note" value="&lt;b&gt;🔑 Commit SHA Traceability&lt;/b&gt;&lt;br&gt;Image built once from feature branch.&lt;br&gt;Same SHA deployed to Dev, UAT, and Production.&lt;br&gt;No rebuild between environments — what you tested is what runs in prod." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;fontStyle=3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="743" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="dev_dep" value="&lt;b&gt;🚀 DEPLOY TO DEV&lt;/b&gt;  (automatic)&lt;br&gt;&lt;br&gt;1. SSH into Dev VM (Ansible)&lt;br&gt;2. Store current tag → PREV&lt;br&gt;3. &lt;b&gt;flyway migrate&lt;/b&gt; (before app)&lt;br&gt;4. docker pull {commit-sha} images&lt;br&gt;5. docker compose up (API + WEB)&lt;br&gt;6. &lt;b&gt;Health check&lt;/b&gt; /health → 200&lt;br&gt;&lt;br&gt;✅ Pass → Dev team runs testing&lt;br&gt;❌ Fail → auto rollback to PREV" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1620" y="815" width="430" height="215" as="geometry"/></mxCell>
        <mxCell id="gate1" value="&lt;b&gt;🔒 GATE 1 — Dev → UAT Promotion&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Dev Lead / QA approves in GitHub Env&lt;br&gt;• workflow_dispatch triggers UAT deploy&lt;br&gt;• GitHub verifies same commit SHA ✅&lt;br&gt;• Cannot trigger UAT deploy without this gate" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="1042" width="430" height="100" as="geometry"/></mxCell>
        <mxCell id="uat_dep" value="&lt;b&gt;🚀 DEPLOY TO UAT&lt;/b&gt;  (same commit SHA)&lt;br&gt;&lt;br&gt;1. SSH into UAT VM (Ansible)&lt;br&gt;2. Store current tag → PREV&lt;br&gt;3. &lt;b&gt;flyway migrate&lt;/b&gt; (before app)&lt;br&gt;4. docker pull &lt;b&gt;same {commit-sha}&lt;/b&gt;&lt;br&gt;5. docker compose up (API + WEB)&lt;br&gt;6. &lt;b&gt;Health check&lt;/b&gt; /health → 200&lt;br&gt;&lt;br&gt;✅ Pass → Nama stakeholders run UAT&lt;br&gt;❌ Fail → auto rollback to PREV" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1620" y="1154" width="430" height="215" as="geometry"/></mxCell>
        <mxCell id="gate2" value="&lt;b&gt;🔒 GATE 2 — UAT Sign-off + Merge to Main&lt;/b&gt;&lt;br&gt;&lt;br&gt;• UAT Lead + Business Analyst sign-off&lt;br&gt;• PR created: feature/INS-123 → main&lt;br&gt;• 2 internal reviewers review + approve PR&lt;br&gt;• PR merged → feature branch deleted ✅&lt;br&gt;• semantic-release on main creates v1.3.0&lt;br&gt;• Images re-tagged: {sha} → v1.3.0" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="1381" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="prd_dep" value="&lt;b&gt;🚀 ROLLING DEPLOY — PRODUCTION&lt;/b&gt;&lt;br&gt;&lt;i&gt;Triggered by merge to main (using v1.3.0 image)&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. Confirm: DB backup &amp;lt; 4h, on-call online&lt;br&gt;2. Remove VM-1 from load balancer&lt;br&gt;3. &lt;b&gt;flyway migrate&lt;/b&gt;&lt;br&gt;4. docker pull v1.3.0 + compose up&lt;br&gt;5. &lt;b&gt;Health check&lt;/b&gt; → re-add VM-1&lt;br&gt;6. Remove VM-2 → repeat steps 3–5&lt;br&gt;7. Watch Grafana dashboards 30 min&lt;br&gt;&lt;br&gt;↩ Rollback: restart prev image tag&lt;br&gt;⏱ ~15 min | Zero downtime" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2075" y="1381" width="380" height="280" as="geometry"/></mxCell>
        <mxCell id="gate3_label" value="&lt;b&gt;🔒 GATE 3&lt;/b&gt;&lt;br&gt;2 GitHub Environment&lt;br&gt;reviewers must approve&lt;br&gt;before prod deploy starts" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2075" y="1290" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="inf_c" value="🇴🇲  OMANTEL / OTECH CLOUD — MUSCAT, OMAN" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="1500" width="2980" height="440" as="geometry"/></mxCell>
        <mxCell id="vpn_bar" value="🔒 VPN Gateway — sole SSH entry point. All access to Dev / UAT / Prod VMs tunnels through VPN." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#37474F;strokeColor=#263238;fontColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="20" y="1540" width="620" height="30" as="geometry"/></mxCell>
        <mxCell id="runner_vm" value="&lt;b&gt;⚡ Dedicated Runner VM&lt;/b&gt;&lt;br&gt;4 CPU / 8 GB / 100 GB SSD&lt;br&gt;&lt;br&gt;GitHub Actions Self-Hosted Runner&lt;br&gt;• Polls GitHub for jobs (outbound)&lt;br&gt;• Docker + SSH + Ansible + Flyway&lt;br&gt;• Separate from Monitoring VM ✅" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="1580" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="mon_vm" value="&lt;b&gt;📊 Monitoring VM&lt;/b&gt;  2 CPU / 4 GB&lt;br&gt;&lt;br&gt;• Prometheus + Grafana&lt;br&gt;• Grafana Loki (log aggregation)&lt;br&gt;• Alertmanager → WhatsApp / PagerDuty&lt;br&gt;• Uptime Kuma (external URL checks)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="470" y="1580" width="370" height="170" as="geometry"/></mxCell>
        <mxCell id="dev_c_inf" value="🌿  DEV ENVIRONMENT  —  dev.permit.nama-water.om" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="850" y="1500" width="530" height="440" as="geometry"/></mxCell>
        <mxCell id="dev_app" value="&lt;b&gt;🖥️ Dev App VM&lt;/b&gt;  2 CPU / 2 GB&lt;br&gt;&lt;br&gt;• nginx + API container&lt;br&gt;• WEB container&lt;br&gt;• PgBouncer&lt;br&gt;&lt;br&gt;Ephemeral data — can wipe&lt;br&gt;and redeploy any time" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="860" y="1545" width="250" height="185" as="geometry"/></mxCell>
        <mxCell id="dev_db" value="&lt;b&gt;🗄️ Dev DB&lt;/b&gt;&lt;br&gt;PostgreSQL 16&lt;br&gt;2 CPU / 4 GB&lt;br&gt;&lt;br&gt;Flyway runs before&lt;br&gt;each deploy" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1120" y="1545" width="250" height="185" as="geometry"/></mxCell>
        <mxCell id="dev_note" value="Dev team runs smoke tests here before approving UAT promotion." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="1740" width="510" height="30" as="geometry"/></mxCell>
        <mxCell id="uat_c_inf" value="📋  UAT / STAGING  —  uat.permit.nama-water.om" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1390" y="1500" width="620" height="440" as="geometry"/></mxCell>
        <mxCell id="uat_app" value="&lt;b&gt;🖥️ UAT App VM&lt;/b&gt;  2 CPU / 4 GB / 50 GB&lt;br&gt;&lt;br&gt;• nginx + API container&lt;br&gt;• WEB container&lt;br&gt;• PgBouncer&lt;br&gt;&lt;br&gt;Same SHA as Dev ✅&lt;br&gt;Nama stakeholders test here" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1400" y="1545" width="290" height="185" as="geometry"/></mxCell>
        <mxCell id="uat_db" value="&lt;b&gt;🗄️ UAT DB&lt;/b&gt;&lt;br&gt;PostgreSQL 16&lt;br&gt;2 CPU / 8 GB / 150 GB&lt;br&gt;&lt;br&gt;Refreshed weekly with&lt;br&gt;anonymised prod data&lt;br&gt;Flyway runs before deploy" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1700" y="1545" width="300" height="185" as="geometry"/></mxCell>
        <mxCell id="uat_note" value="✅ UAT mirrors Production config. UAT sign-off = meaningful approval." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="1740" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="prd_c_inf" value="🏭  PRODUCTION  —  permit.nama-water.om" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2020" y="1500" width="970" height="440" as="geometry"/></mxCell>
        <mxCell id="elb" value="&lt;b&gt;⚖️ Elastic Load Balancer&lt;/b&gt;&lt;br&gt;HTTPS 443 — TLS terminated&lt;br&gt;Health check every 10 sec&lt;br&gt;Round-robin VM-1 / VM-2" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2030" y="1545" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="vm1" value="&lt;b&gt;🖥️ App VM-1&lt;/b&gt;&lt;br&gt;4 CPU / 8 GB / 100 GB&lt;br&gt;10.0.2.10&lt;br&gt;• nginx · API · WEB · PgBouncer" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2030" y="1665" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="vm2" value="&lt;b&gt;🖥️ App VM-2&lt;/b&gt;&lt;br&gt;4 CPU / 8 GB / 100 GB&lt;br&gt;10.0.2.11&lt;br&gt;• nginx · API · WEB · PgBouncer" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2310" y="1665" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="roll_note" value="&lt;b&gt;🔄 Rolling Deploy&lt;/b&gt;&lt;br&gt;VM-1 → health ✅&lt;br&gt;VM-2 → health ✅&lt;br&gt;Zero downtime" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2310" y="1545" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="prd_db" value="&lt;b&gt;🗄️ DB VM (Primary)&lt;/b&gt;&lt;br&gt;PostgreSQL 16&lt;br&gt;4 CPU / 16 GB / 200 GB NVMe&lt;br&gt;10.0.3.5&lt;br&gt;&lt;br&gt;• WAL → OBS continuous&lt;br&gt;• Daily backup 01:30 GST&lt;br&gt;• PITR: 30-day window" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2590" y="1545" width="270" height="240" as="geometry"/></mxCell>
        <mxCell id="obs" value="&lt;b&gt;☁️ OBS Backup&lt;/b&gt;&lt;br&gt;DB backups&lt;br&gt;Photos + PDFs&lt;br&gt;Cross-DC replication&lt;br&gt;Omantel SDC (20 km)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2590" y="1795" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="mob_c" value="📱  MOBILE APP PIPELINE  (.github/workflows/mobile-build.yml — same Feature Branch Promotion gates)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="1950" width="2980" height="360" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;✅ LINT + TYPE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• flutter analyze&lt;br&gt;• tsc --noEmit&lt;br&gt;⏱ ~1 min" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="20" y="1995" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;✅ UNIT TESTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• flutter test&lt;br&gt;• API transformers&lt;br&gt;• Form validators&lt;br&gt;⏱ ~2 min" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="280" y="1995" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;🤖 ANDROID BUILD&lt;/b&gt;&lt;br&gt;(Linux Runner)&lt;br&gt;&lt;br&gt;• flutter build appbundle&lt;br&gt;• ANDROID_KEYSTORE secret&lt;br&gt;• Decoded/signed/deleted&lt;br&gt;⏱ ~8 min" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8EAF6;strokeColor=#3F51B5;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="540" y="1995" width="290" height="165" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;🍎 iOS — CODEMAGIC&lt;/b&gt;&lt;br&gt;&lt;br&gt;curl POST api.codemagic.io/builds&lt;br&gt;&amp;nbsp;&amp;nbsp;{ workflow: ios-release }&lt;br&gt;poll_codemagic.sh (60s intervals)&lt;br&gt;GitHub job fails if CM fails ✅&lt;br&gt;⏱ ~20 min (macOS)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8EAF6;strokeColor=#3F51B5;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="840" y="1995" width="460" height="165" as="geometry"/></mxCell>
        <mxCell id="m5" value="&lt;b&gt;📲 DISTRIBUTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Android →&lt;br&gt;&amp;nbsp;&amp;nbsp;Firebase App Dist.&lt;br&gt;iOS →&lt;br&gt;&amp;nbsp;&amp;nbsp;TestFlight&lt;br&gt;(via Codemagic)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8EAF6;strokeColor=#3F51B5;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="1310" y="1995" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="m6" value="&lt;b&gt;🔒 MANUAL GATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;2 approvals required&lt;br&gt;&lt;br&gt;Store releases&lt;br&gt;cannot be rolled back" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1590" y="1995" width="240" height="165" as="geometry"/></mxCell>
        <mxCell id="m7" value="&lt;b&gt;🏪 STORE RELEASE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Android&lt;/b&gt; → Play Store&lt;br&gt;&amp;nbsp;&amp;nbsp;Fastlane / Play API&lt;br&gt;&lt;b&gt;iOS&lt;/b&gt; → App Store Connect&lt;br&gt;&amp;nbsp;&amp;nbsp;Apple review: 24–48h&lt;br&gt;Version: 1.3.0+{pipeline_id}" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8EAF6;strokeColor=#3F51B5;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="1840" y="1995" width="360" height="165" as="geometry"/></mxCell>
        <mxCell id="ext" value="&lt;b&gt;📲 External Services&lt;/b&gt;&lt;br&gt;&lt;br&gt;• FCM — Android push&lt;br&gt;• APNs — iOS push&lt;br&gt;• WhatsApp Business API&lt;br&gt;• App Store / Google Play" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="2210" y="1995" width="430" height="165" as="geometry"/></mxCell>
