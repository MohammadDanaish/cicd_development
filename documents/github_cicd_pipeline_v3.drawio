        <mxCell id="dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#E65100;" value="branch?" vertex="1">
