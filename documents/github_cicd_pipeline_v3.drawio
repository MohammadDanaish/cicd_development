        <mxCell id="repo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" value="&lt;b&gt;📁 Repository (nama-tipms)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Trunk-Based Development ✅&lt;/b&gt;&lt;br&gt;&lt;br&gt;feature/* → &lt;b&gt;main&lt;/b&gt; → v-tag&lt;br&gt;&lt;br&gt;❌ No develop/staging branches&lt;br&gt;✅ 2 approvals to merge to main&lt;br&gt;✅ CI must pass before merge&lt;br&gt;✅ Conventional Commits enforced" vertex="1">
