        </mxCell>
        <mxCell id="stg_dep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" value="&lt;b&gt;🚀 AUTO DEPLOY — STAGING&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Save current tag → PREV &lt;i&gt;★A1&lt;/i&gt;&lt;br&gt;2. &lt;b&gt;flyway migrate&lt;/b&gt; (before app) &lt;i&gt;★A3&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Aborts if migration fails&lt;br&gt;3. docker pull both images&lt;br&gt;4. docker compose up (API + WEB)&lt;br&gt;5. &lt;b&gt;Health check&lt;/b&gt; &lt;i&gt;★M3&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;curl --retry 5 /health → 200&lt;br&gt;&lt;br&gt;✅ Pass → notify team&lt;br&gt;❌ Fail → docker compose up $PREV&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Auto rollback&lt;/b&gt; &lt;i&gt;★A1&lt;/i&gt;" vertex="1">
          <mxGeometry height="280" width="430" x="1320" y="780" as="geometry" />
        </mxCell>
        <mxCell id="prd_trg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" value="&lt;b&gt;🔒 workflow_dispatch only&lt;/b&gt; &lt;i&gt;★G4&lt;/i&gt;&lt;br&gt;Requires version tag v*.*.*&lt;br&gt;Never auto-triggered" vertex="1">
          <mxGeometry height="65" width="360" x="2180" y="705" as="geometry" />
        </mxCell>
        <mxCell id="prd_gat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFEBEE;strokeColor=#D32F2F;fontColor=#B71C1C;fontStyle=1;" value="&lt;b&gt;🔒 APPROVAL GATE&lt;/b&gt; &lt;i&gt;★G5&lt;/i&gt;&lt;br&gt;&lt;br&gt;✅ 2 internal reviewers (GitHub Env)&lt;br&gt;✅ Nama UAT via GitHub Issue&lt;br&gt;&amp;nbsp;&amp;nbsp;(no GitHub account needed)&lt;br&gt;✅ Staging stable &amp;gt;= 24 hours&lt;br&gt;✅ DB backup &amp;lt; 4 hours ago&lt;br&gt;✅ On-call engineer confirmed" vertex="1">
          <mxGeometry height="145" width="360" x="2200" y="790" as="geometry" />
        </mxCell>
        <mxCell id="prd_dep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" value="&lt;b&gt;🚀 ROLLING DEPLOY — PRODUCTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Remove VM-1 from load balancer&lt;br&gt;2. &lt;b&gt;flyway migrate&lt;/b&gt; &lt;i&gt;★A3&lt;/i&gt;&lt;br&gt;3. docker pull + compose up&lt;br&gt;4. &lt;b&gt;Health check&lt;/b&gt; → re-add VM-1 &lt;i&gt;★M3&lt;/i&gt;&lt;br&gt;5. Remove VM-2, repeat steps 2–4&lt;br&gt;6. Both VMs healthy ✅&lt;br&gt;7. Watch Grafana dashboards 30 min&lt;br&gt;&lt;br&gt;↩ Rollback: restart prev image &lt;i&gt;★A1&lt;/i&gt;&lt;br&gt;⏱ ~15 min | Zero downtime" vertex="1">
          <mxGeometry height="220" width="360" x="1850" y="910" as="geometry" />
        </mxCell>
