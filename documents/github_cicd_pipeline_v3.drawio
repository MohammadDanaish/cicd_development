        <mxCell id="stg_db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" value="&lt;b&gt;🗄️ DB VM&lt;/b&gt;  PostgreSQL 16&lt;br&gt;2 CPU / 8 GB / 150 GB&lt;br&gt;&lt;br&gt;• Flyway runs before app starts&lt;br&gt;• Refreshed weekly with&lt;br&gt;&amp;nbsp;&amp;nbsp;anonymised production data" vertex="1">
