        <mxCell id="cache_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;" value="🚀 actions/cache enabled: node_modules · ~/.gradle · pub-cache  &lt;i&gt;★G2&lt;/i&gt;  |  🐳 Docker BuildKit layer cache: cache-from/cache-to type=gha (base images cached per branch)  &lt;i&gt;★G6&lt;/i&gt;" vertex="1">
          <mxGeometry height="35" width="1460" x="1510" y="432" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" value="&lt;b&gt;✅ STAGE 1 — VALIDATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ESLint + Prettier + Stylelint&lt;br&gt;• Gitleaks (secret detection)&lt;br&gt;• npm audit (dep CVEs) &lt;i&gt;★M5&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Snyk (SCA)&lt;/b&gt; — dep vuln + licence &lt;i&gt;★S1&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;FAIL: critical/high CVEs&lt;br&gt;&amp;nbsp;&amp;nbsp;WARN: medium (weekly review)&lt;br&gt;&lt;br&gt;Fails PR merge on any error&lt;br&gt;⏱ ~90 seconds" vertex="1">
          <mxGeometry height="205" width="330" x="20" y="477" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" value="&lt;b&gt;✅ STAGE 2 — TEST&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Vitest (Vue 3 unit tests)&lt;br&gt;• Jest (Node.js API tests)&lt;br&gt;• Coverage ≥ 70% enforced &lt;i&gt;★M4&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Integration Tests&lt;/b&gt; &lt;i&gt;★M2&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;services: postgres:16 (real DB)&lt;br&gt;&amp;nbsp;&amp;nbsp;Catches: JOINs, constraints&lt;br&gt;⏱ ~3 minutes" vertex="1">
          <mxGeometry height="205" width="350" x="360" y="477" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" value="&lt;b&gt;✅ STAGE 3 — SAST&lt;/b&gt; &lt;i&gt;★M5&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Semgrep / GitHub CodeQL&lt;br&gt;• SQL injection, XSS, OWASP Top 10&lt;br&gt;&lt;br&gt;FAIL: HIGH / CRITICAL findings&lt;br&gt;WARN: MEDIUM (weekly review)&lt;br&gt;⏱ ~2 minutes" vertex="1">
          <mxGeometry height="205" width="290" x="720" y="477" as="geometry" />
