        <mxCell id="gh_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" value="☁️  GITHUB.COM" vertex="1">
