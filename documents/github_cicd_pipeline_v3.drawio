        <mxCell id="s4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;" value="&lt;b&gt;🟢 FRONTEND IMAGE&lt;/b&gt;&lt;br&gt;npm run build → dist/ [Vite]&lt;br&gt;FROM nginx:1.27-alpine &lt;i&gt;★C2&lt;/i&gt;&lt;br&gt;COPY dist/ → nginx html root&lt;br&gt;--cache-from type=gha · --cache-to type=gha &lt;i&gt;★G6&lt;/i&gt;&lt;br&gt;→ nama-permit-web:{tag}" vertex="1">
          <mxGeometry height="85" width="380" x="1020" y="660" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;" value="&lt;b&gt;✅ STAGE 5 — IMAGE SCAN&lt;/b&gt; &lt;i&gt;★M5&lt;/i&gt;&lt;br&gt;&lt;br&gt;Scans both built images&lt;br&gt;&lt;b&gt;Trivy&lt;/b&gt; — OS CVEs in image layers&lt;br&gt;&lt;b&gt;Snyk container&lt;/b&gt; — app dep CVEs &lt;i&gt;★S1&lt;/i&gt;&lt;br&gt;&lt;br&gt;FAIL: CRITICAL CVEs&lt;br&gt;WARN: HIGH CVEs&lt;br&gt;&lt;i&gt;(separate from SAST + npm audit)&lt;/i&gt;&lt;br&gt;⏱ ~3 minutes" vertex="1">
          <mxGeometry height="205" width="285" x="1440" y="500" as="geometry" />
        </mxCell>
        <mxCell id="s6a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" value="&lt;b&gt;🏷️ semantic-release&lt;/b&gt; &lt;i&gt;★M1&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Reads commits since last release&lt;br&gt;• Bumps SemVer: feat→minor, fix→patch&lt;br&gt;• Creates git tag (e.g. v1.3.0)&lt;br&gt;• Generates CHANGELOG.md&lt;br&gt;• Creates GitHub Release&lt;br&gt;&lt;i&gt;main branch only&lt;/i&gt;" vertex="1">
          <mxGeometry height="115" width="310" x="1770" y="467" as="geometry" />
        </mxCell>
        <mxCell id="s6b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;" value="&lt;b&gt;📤 PUSH TO GHCR&lt;/b&gt; &lt;i&gt;★G3&lt;/i&gt;&lt;br&gt;&lt;br&gt;docker login ghcr.io&lt;br&gt;&amp;nbsp;&amp;nbsp;uses GITHUB_TOKEN ✅&lt;br&gt;Pushes: API image + WEB image&lt;br&gt;&lt;i&gt;main + version tags only&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="310" x="1740" y="596" as="geometry" />
        </mxCell>
        <mxCell id="conc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;fontStyle=3;fontSize=11;" value="&lt;b&gt;concurrency:&lt;/b&gt; &lt;i&gt;★G1&lt;/i&gt;&lt;br&gt;group: deploy-${{github.ref}}&lt;br&gt;cancel-in-progress: true" vertex="1">
          <mxGeometry height="50" width="310" x="1790" y="730" as="geometry" />
