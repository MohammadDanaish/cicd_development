        <mxCell id="vpn_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#37474F;strokeColor=#263238;fontColor=#ECEFF1;" value="🔒 VPN Gateway — sole SSH entry point. All access to App / DB VMs goes through VPN." vertex="1">
          <mxGeometry height="30" width="560" x="20" y="1205" as="geometry" />
        </mxCell>
        <mxCell id="runner_vm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" value="&lt;b&gt;⚡ Dedicated Runner VM&lt;/b&gt; &lt;i&gt;★A2&lt;/i&gt;&lt;br&gt;4 CPU / 8 GB / 100 GB SSD&lt;br&gt;&lt;br&gt;GitHub Actions Self-Hosted Runner&lt;br&gt;• Polls GitHub for jobs (outbound)&lt;br&gt;• Docker + SSH + Ansible + Flyway CLI&lt;br&gt;• Separate from Monitoring VM ✅&lt;br&gt;• No resource contention" vertex="1">
          <mxGeometry height="185" width="450" x="20" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="mon_vm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" value="&lt;b&gt;📊 Monitoring VM&lt;/b&gt;  2 CPU / 4 GB&lt;br&gt;&lt;br&gt;• Prometheus + Grafana&lt;br&gt;• Grafana Loki ← Promtail (app logs) &lt;i&gt;★L1&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Retention: 30 days&lt;br&gt;• Alertmanager → WhatsApp / PagerDuty&lt;br&gt;• Uptime Kuma (external checks)&lt;br&gt;&lt;br&gt;CI runner removed &lt;i&gt;★A2&lt;/i&gt;" vertex="1">
          <mxGeometry height="185" width="370" x="480" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="stg_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" value="🧪  STAGING — staging.permit.nama-water.om" vertex="1">
          <mxGeometry height="410" width="680" x="860" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="stg_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" value="&lt;b&gt;🖥️ App VM&lt;/b&gt;  2 CPU / 4 GB / 50 GB&lt;br&gt;&lt;br&gt;• nginx (reverse proxy)&lt;br&gt;• nama-permit-api container&lt;br&gt;• nama-permit-web container&lt;br&gt;• PgBouncer container&lt;br&gt;• &lt;b&gt;Promtail&lt;/b&gt; — scrapes Docker JSON logs &lt;i&gt;★L1&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ ships to Loki on Monitoring VM&lt;br&gt;&amp;nbsp;&amp;nbsp;App logs: structured JSON (pino)&lt;br&gt;&lt;br&gt;Single VM — fine for UAT" vertex="1">
