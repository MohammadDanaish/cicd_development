        <mxCell id="trigger_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;" value="⚡ Triggered by: Push to any branch  |  Pull Request  |  git tag v*.*.*  |  workflow_dispatch (production only)" vertex="1">
