        <mxCell id="ghcr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" value="&lt;b&gt;📦 GHCR — 2 Separate Images ✅&lt;/b&gt;&lt;br&gt;&lt;i&gt;Fixed: C1 + C2&lt;/i&gt;&lt;br&gt;&lt;br&gt;🔵 &lt;b&gt;nama-permit-api:{ver}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;FROM node:20.11-alpine3.19&lt;br&gt;&amp;nbsp;&amp;nbsp;API only (no frontend)&lt;br&gt;&lt;br&gt;🟢 &lt;b&gt;nama-permit-web:{ver}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;FROM nginx:1.27-alpine&lt;br&gt;&amp;nbsp;&amp;nbsp;Static dist/ files only" vertex="1">
