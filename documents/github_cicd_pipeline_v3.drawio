        <mxCell id="secrets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" value="&lt;b&gt;🔐 GitHub Secrets&lt;/b&gt;&lt;br&gt;&lt;br&gt;• DB_PASSWORD&lt;br&gt;• JWT_SECRET_KEY&lt;br&gt;• FCM_SERVER_KEY&lt;br&gt;• APNS_AUTH_KEY&lt;br&gt;• ANDROID_KEYSTORE (file)&lt;br&gt;• CODEMAGIC_API_TOKEN&lt;br&gt;• SRV_STAGING_SSH_KEY&lt;br&gt;• SRV_PROD_SSH_KEY" vertex="1">
          <mxGeometry height="255" width="370" x="1370" y="115" as="geometry" />
        </mxCell>
        <mxCell id="gh_envs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fillColor=#24292e;strokeColor=#0D7377;fontColor=#FFFFFF;strokeWidth=3;" value="&lt;b&gt;🌍 GitHub Environments&lt;/b&gt;&lt;br&gt;&lt;br&gt;📋 &lt;b&gt;staging&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Auto on merge to main&lt;br&gt;&amp;nbsp;&amp;nbsp;• concurrency group (no parallel deploys) &lt;i&gt;★G1&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• No approval gate&lt;br&gt;&lt;br&gt;🔒 &lt;b&gt;production&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• workflow_dispatch ONLY &lt;i&gt;★G4&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• 2 internal reviewers required &lt;i&gt;★G5&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Version tag v*.*.* required&lt;br&gt;&amp;nbsp;&amp;nbsp;• Window: Sunday 03:00–06:00 OST" vertex="1">
          <mxGeometry height="255" width="1230" x="1750" y="115" as="geometry" />
        </mxCell>
        <mxCell id="pipe_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;strokeWidth=3;fontStyle=1;fontFamily=Helvetica;fontSize=13;fontSize=13;fillColor=#1E2D40;strokeColor=#0D7377;fontColor=#FFFFFF;" value="⚙️  GITHUB ACTIONS — CI/CD PIPELINE  (.github/workflows/)" vertex="1">
